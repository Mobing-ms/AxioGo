# Copy this file to .env and fill in real values. Never commit .env.

# --- Database (Postgres-compatible; SQLite default works with no setup) ---
DATABASE_URL=sqlite+aiosqlite:///./axiogo_dev.db

# --- Auth ---
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS (comma-separated allowed frontend origins) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# --- LLM (Gemini via LangChain) ---
# Leave empty to run AXIS with the deterministic offline stub.
GOOGLE_API_KEY=
AXIS_MODEL_NAME=gemini-2.0-flash

# --- Databricks (leave empty to run the simulated adapter) ---
DATABRICKS_HOST=
DATABRICKS_TOKEN=

# --- Frontend (consumed by client/, not the backend) ---
API_BASE_URL=http://localhost:8000/api/v1
