# Copy this file to .env and fill in real values.
# Never commit .env.

# =========================================================
# Database
# =========================================================

# Postgres-compatible.
# SQLite default works with no external database setup.
DATABASE_URL=sqlite+aiosqlite:///./axiogo_dev.db


# =========================================================
# Authentication
# =========================================================

# Backend-issued AxioGo session token signing key. Required in production.
# Leaving this empty is allowed only for local development, where a non-secret
# fallback is used. Generate a long, unique value for every deployment.
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7


# =========================================================
# Supabase
# =========================================================

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=


# =========================================================
# CORS
# =========================================================

# Comma-separated allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173


# =========================================================
# LLM
# =========================================================

# Gemini via LangChain.
# Leave empty to run AXIS with the deterministic offline stub.
GOOGLE_API_KEY=
AXIS_MODEL_NAME=gemini-2.0-flash


# =========================================================
# Databricks
# =========================================================

# Leave empty to run the simulated adapter.
DATABRICKS_HOST=
DATABRICKS_TOKEN=


# =========================================================
# Frontend
# =========================================================

# API base URL consumed by client/.
API_BASE_URL=http://localhost:8000/api/v1